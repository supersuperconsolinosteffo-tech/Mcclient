{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vespera Client",
  "version": "1.0.0",
  "identifier": "gg.vespera.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist/ui"
  },
  "app": {
    "windows": [
      {
        "title": "Vespera Client — Precision Minecraft Java Edition Client",
        "width": 1340,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["../native/resources/vespera.ico"]
  }
}
